# Source-only release: keep model code and its required runtime definitions.
# Everything else (including datasets, assets, cache, memory_banks, results,
# seed, logs, weights, paper drafts and local/experimental tools) stays local.
*
!/.gitignore
!/README.md
!/pyproject.toml

!/src/
!/src/**/
!/src/**/*.py

!/scripts/
!/scripts/fill_measurement_templates.py
!/scripts/castjm/
!/scripts/castjm/build_memory.py
!/scripts/castjm/evaluate_rule_castjm_mvtec_loco.py
!/scripts/castjm/evaluate_mvtec_loco.py
!/scripts/castjm/evaluate_pixel_texture.py

!/templates/
!/templates/store/
!/templates/store/*.rules
!/examples/
!/examples/*.rules

!/config/
!/config/attribute_vocabulary.example.json
!/config/juice_bottle.attribute_vocabulary.json
!/config/splicing_connectors.attribute_vocabulary.json
!/config/sam3_thresholds/
!/config/sam3_thresholds/confidence_gap_midpoint_4-shot/
!/config/sam3_thresholds/confidence_gap_midpoint_4-shot/*.json
!/config/environment/
!/config/environment/requirements-inference.txt
